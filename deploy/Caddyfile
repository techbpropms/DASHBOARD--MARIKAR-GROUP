# Marikar Group performance hub on the Hostinger VPS. Caddy serves the static site from /srv/hub/site and
# obtains and renews the HTTPS certificate for the hub's name by itself once DNS points here.
mmlpbi.bpropms.in {
	root * /srv/hub/site
	encode gzip zstd
	file_server

	# The service worker and the version file must never be cached by the browser or a proxy.
	@fresh path /sw.js /version.json /data/* /assets/auth.js
	header @fresh Cache-Control "no-cache, no-store, must-revalidate"
	header /assets/* Cache-Control "public, max-age=3600"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Pretty addresses used by the hub (dashboard, settings, ...) resolve to their .html files.
	try_files {path} {path}.html {path}/index.html

	log {
		output file /var/log/caddy/hub-access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Until DNS moves, the server also answers on its own IP address (self-signed certificate), so the
# deployment can be checked with: curl -k https://<ip>/version.json -H 'Host: mmlpbi.bpropms.in'
:443 {
	tls internal
	root * /srv/hub/site
	file_server
	try_files {path} {path}.html {path}/index.html
}
