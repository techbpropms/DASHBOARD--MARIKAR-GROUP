# Copy to .env on the server (never commit .env) and load it with: set -a; . ./.env; set +a; node server.js
# The mailbox the hub sends from and the administrator reads.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mml@bpropms.in
SMTP_PASS=                      # the mailbox password: set it here on the server only
MAIL_FROM=Marikar Group performance hub <mml@bpropms.in>
ADMIN_TO=mml@bpropms.in
HUB_URL=https://mmlpbi.bpropms.in
ALLOWED_ORIGINS=https://mmlpbi.bpropms.in
PORT=8787
RATE_PER_HOUR=5
# DRY_RUN=1                     # log mails instead of sending (for a first start without the password)
